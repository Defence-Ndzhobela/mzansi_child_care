NODE_ENV=development
# Render injects its own PORT. Locally this default is used.
PORT=5000
# Local only: bind to the loopback interface. Leave HOST unset in production (Render needs all interfaces).
HOST=127.0.0.1

# Public URLs of the two apps (origins only: no path, no trailing slash needed).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Extra browser origins allowed to call the API (comma separated, exact match, no "*").
# FRONTEND_URL and BACKEND_URL are always allowed. Add the Vite dev server and the deployed frontend here.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Session cookie SameSite policy: strict (default), lax or none.
# Use "none" only when the frontend and backend are on different sites (for example
# vercel.app + onrender.com). It requires an https BACKEND_URL and sends cookies cross-site.
COOKIE_SAME_SITE=strict

DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# At least 32 random bytes. Rotating it also breaks child-ID lookup digests (see README).
JWT_SECRET=

# AI assistant on the public pages (optional). Without a key the assistant says it is unavailable and
# nothing else changes. The key is only ever read by the backend. Never put it in the frontend.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
# Set to true behind a reverse proxy such as Render so rate limits see each visitor's real address.
# TRUST_PROXY=true
# Production example (set these in the Render dashboard instead of a file):
# NODE_ENV=production
# FRONTEND_URL=https://your-project.vercel.app
# BACKEND_URL=https://your-render-backend.onrender.com
# CORS_ORIGINS=https://your-project.vercel.app
# COOKIE_SAME_SITE=none
